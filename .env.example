# Google Tag Manager container id (e.g. GTM-XXXXXXX).
# Set in Vercel (Production + Preview) to activate analytics/ads/pixel tracking.
# When unset, NO tracking is injected (safe no-op). NEXT_PUBLIC_* is exposed to
# the browser, which is expected for a GTM container id.
NEXT_PUBLIC_GTM_ID=

# Meta (Facebook) Pixel — website conversion tracking. Browser Pixel is in
# layout.tsx; the server-side Conversions API event is forwarded to a Supabase
# relay (functions/meta-capi) that holds the Meta token and hashes PII, so the
# Meta token never touches this website. Browser + server events dedupe via a
# shared event_id. GTM handles Google Ads + GA4 only; pause the Meta tags in GTM
# so the pixel is not double-fired.
# Use the dedicated WEB pixel 2276844006474199 ("EZOrders Web Pixel") — NOT the
# app dataset 1685991296574188 ("EZOrders Platform").
#   NEXT_PUBLIC_META_PIXEL_ID: numeric pixel id, browser side (exposed by design).
#   CAPI_FORWARD_SECRET: shared secret that authorizes this site to call the
#     Supabase meta-capi relay (must match the same var set in Supabase).
#   META_CAPI_RELAY_URL: optional override of the relay endpoint (defaults to the
#     project's meta-capi function URL).
# Both unset = no Meta tracking (safe no-op). The Meta token + META_PIXEL_ID live
# in Supabase (meta-capi function), never here.
NEXT_PUBLIC_META_PIXEL_ID=
CAPI_FORWARD_SECRET=

# Meta Business domain verification code (from Business Settings → Brand safety →
# Domains → meta-tag method). Enables Aggregated Event Measurement. Safe no-op
# when unset. Exposed to the browser by design (it is a public meta tag).
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=

# Contact form — email delivery (required for /api/contact to send leads)
# Set these in Vercel → Project Settings → Environment Variables (Production).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_FROM_EMAIL=EzOrders <leads@ezorders.com>
CONTACT_TO_EMAIL=contact@ezorders.com

# Contact form — CAPTCHA via Cloudflare Turnstile (OPTIONAL, dormant by default)
# Leave both unset to keep the form CAPTCHA-free (honeypot + rate limiting stay active).
# Set BOTH to enable Turnstile: the widget appears on the form and every
# submission is verified server-side before an email is sent.
#   - Get keys at https://dash.cloudflare.com → Turnstile (free)
#   - NEXT_PUBLIC_* is exposed to the browser (that is expected for the site key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional CRM webhook (not currently used by the route)
# CRM_LEAD_WEBHOOK_URL=
# CRM_LEAD_WEBHOOK_SECRET=
